rules_version = '2';

// Storage layout:
//   org-logos/{orgId}/...        -> organization branding logos
//   event-images/{eventId}/...   -> event cover / gallery images
//
// Reads are public (branding + event images are shown on the hosted
// checkout page to anonymous payers). Writes are restricted to
// authenticated admins of the owning organization. Uploads are capped
// at 5 MB and must be images.
service firebase.storage {
  match /b/{bucket}/o {

    function isImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
    }

    function isOrgAdmin(orgId) {
      return request.auth != null
        && request.auth.token.orgId == orgId
        && request.auth.token.role in ['admin', 'manager'];
    }

    match /org-logos/{orgId}/{fileName} {
      allow read: if true;
      allow write: if isOrgAdmin(orgId) && isImage();
    }

    match /event-images/{eventId}/{fileName} {
      allow read: if true;
      // Event ownership is validated in the callable that returns the
      // upload path; here we require an authenticated admin/manager.
      allow write: if request.auth != null
        && request.auth.token.role in ['admin', 'manager']
        && isImage();
    }
  }
}
