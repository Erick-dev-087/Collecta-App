# ---------------------------------------------------------------------------
# Collecta Backend — Environment Variables

PORT=8080

# ---------------------------------------------------------------------------
# Firebase Admin SDK — Service Account
# ---------------------------------------------------------------------------
# Go to Firebase Console → Project Settings → Service Accounts → Generate
# New Private Key. Paste the ENTIRE JSON content as the value (single line).
# On Render: add this as an environment variable.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase Project ID (matches your Firebase project)
FIREBASE_PROJECT_ID=collecta-b54a9

# ---------------------------------------------------------------------------
# Safaricom Daraja (M-Pesa) Credentials
# ---------------------------------------------------------------------------

# sandbox | production
DARAJA_ENV=sandbox


DARAJA_CONSUMER_KEY=your_sandbox_consumer_key


DARAJA_CONSUMER_SECRET=your_sandbox_consumer_secret

# Default STK Push shortcode (sandbox test paybill is 174379).

DARAJA_SHORTCODE=174379

# Daraja passkey for STK Push password generation
DARAJA_PASSKEY=your_sandbox_passkey

DARAJA_MOCK=false


PUBLIC_CALLBACK_BASE_URL=https://your-app.onrender.com

# Base URL for shareable payment short links (hosted checkout page)
PUBLIC_CHECKOUT_BASE_URL=https://your-app.onrender.com
